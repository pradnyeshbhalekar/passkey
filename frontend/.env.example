# Frontend environment example (Create React App)
# Copy this to .env in the frontend folder and replace values before running the dev server.
# NOTE: Create React App exposes only variables prefixed with REACT_APP_ to the browser.

# Backend API base URL for axios/fetch calls
REACT_APP_API_URL=http://localhost:5001

# Optional: Google OAuth client id used client-side (if using Google OAuth)
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Any other client-visible variables must also include the REACT_APP_ prefix
# REACT_APP_FEATURE_FLAG=true
